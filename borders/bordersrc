#!/bin/bash

# Active palette colors (generated by `theme switch`).
source "$HOME/.config/theme/active/sketchybar/colors.sh"

# Locked border values (see COLORS.md "Window borders" section) - keep in lockstep with
# sketchybar/plugins/frontapps.sh, which overrides active_color per-window by AeroSpace layout.
# active_color here is only the static fallback for a window before frontapps.sh has tinted it at
# least once (e.g. right after this daemon restarts). inactive_color and width apply to every
# window regardless of layout.
options=(
	style=round
	width=5.0
	hidpi=off
  ax_focus=off
  active_color=$THEME_BORDER_ACTIVE
	inactive_color=$THEME_BORDER_INACTIVE
)

# frontapps.sh caches per-window tint colors in /tmp/aerospace_border_colors and only
# re-applies via `borders apply-to=` when a window's color CHANGED since the cache, to
# avoid redundant calls. Every borders cold start (this script) resets every window back
# to the static active_color/inactive_color above, but the cache doesn't know that -- so
# without this clear, a restarted borders daemon silently keeps stale per-window colors
# until each window's focus/layout actually changes. Clear it here so the daemon coming up is the
# single trigger point for a full re-tint, regardless of which caller restarted it
# (AeroSpace after-startup-command, gaming.lua exit).
rm -f /tmp/aerospace_border_colors

# Absolute path: this script can be sourced from environments without
# /opt/homebrew/bin on $PATH (e.g. Hammerspoon's GUI process env).
/opt/homebrew/bin/borders "${options[@]}"
