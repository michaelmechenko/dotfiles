keybind = cmd+shift+x=close_surface
# keybind = cmd+w=close_window
keybind = cmd+q=quit
# keybind = cmd+shift+f=toggle_fullscreen
keybind = cmd+shift+r=reload_config

quick-terminal-position = bottom
keybind = global:cmd+shift+e=toggle_quick_terminal

# Update modified arrow bindings. Super-arrow is used by pi for line start/end.
keybind = alt+left=csi:1;3D
keybind = alt+right=csi:1;3C
keybind = cmd+left=csi:1;9D
keybind = cmd+right=csi:1;9C

# alt+enter: without this, Ghostty doesn't send a modified Enter for Option+Return,
# so pi (and tmux, via extended-keys/csi-u) can't distinguish it from plain Enter and
# pi's "tui.input.newLine" alt+enter binding never fires. csi:13;3u is the CSI-u
# encoding for Alt+Enter (13 = CR keycode, 3 = Alt modifier) -- same recipe pi's own
# terminal-setup docs give for WezTerm/Alacritty/Windows Terminal.
keybind = alt+enter=csi:13;3u
keybind = shift+enter=csi:13;2u
keybind = ctrl+enter=csi:13;5u

# alt+tab: CSI-u for Alt+Tab (9 = HT keycode, 3 = Alt modifier). Test bind below in
# tmux.conf confirms the sequence reaches tmux before we wire the sidebar toggle to it.
keybind = alt+tab=csi:9;3u

# ctrl+tab -> F13 (^[[25~): an unmodified key so tmux forwards it verbatim
# (a modified key like ctrl+shift+e gets downgraded by tmux without extended-keys).
# zsh binds ^[[25~ to accept the whole autosuggestion.
keybind = ctrl+tab=csi:25~
