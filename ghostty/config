# theme = rose-pine
# theme = catppuccin-mocha
# theme = Kanagawa Wave
# theme = oldworld
theme = vague

# none/detect/zsh
shell-integration = zsh 
shell-integration-features = no-cursor, sudo, ssh-env, ssh-terminfo

cursor-style = underline
cursor-style-blink = false

# background-opacity = 0.97
# background-blur-radius = 50
# unfocused-split-opacity = 0.75
# custom-shader = bloom.glsl

# window-theme = auto
# window-vsync = false

window-padding-x = 12
window-padding-y = 10, 2

# Match tmux window-style bg so padding wraps the inactive pane field seamlessly
background = #100E11
foreground = #cdcdcd

# ANSI 14 (bright cyan) is remapped to dim Claude Code's hardcoded
# session-rename label (#bebeda was too bright). No CC theme token exists
# for it — see github anthropics/claude-code#37349.
palette = 14=#606079

# ANSI 12 (bright blue) is remapped from accent-info slate (#8ba9c1) to
# accent-secondary lavender (#aeaed1). Claude Code's dark-ansi-based theme has
# no token for code-block syntax highlighting — it inherits ANSI 12 — so this
# recolors Claude's syntax-highlight blue (also affects any other ANSI-12
# output, e.g. bat --theme=ansi).
palette = 12=#aeaed1

# bold-is-bright = true

# macos-titlebar-style = tabs
# hidden gives rounded corners with a hidden titlebar + hidden traffic lights.
# Known issues on Ghostty 1.3.2 / macOS 27 + AeroSpace: a tip-build rendering
# desync (new windows paint opaque/blank until a redraw) and a gray/reserved
# titlebar strip at the top. Staying on hidden and waiting for an upstream fix;
# window-decoration=false is the square, artifact-free fallback if needed.
# See: github.com/ghostty-org/ghostty/discussions/13320
# macos-titlebar-style = transparent
# window-decoration = false
macos-titlebar-style = hidden
# macos-window-buttons = hidden
# title = " "  # no titlebar to show a title in when window-decoration=none
macos-window-shadow = false
macos-titlebar-proxy-icon = hidden
macos-icon = custom-style
macos-icon-frame = plastic
macos-icon-ghost-color = #eb6f92
macos-icon-screen-color = #9893a5

resize-overlay = never

