+++ b/include/util/grayscale_icon.hpp
@@ -0,0 +1,13 @@
+#pragma once
+
+#include <gdkmm/pixbuf.h>
+
+namespace waybar::util {
+// Work on a private copy: GTK theme and SNI pixbufs may be cached/shared.
+inline Glib::RefPtr<Gdk::Pixbuf> grayscale_icon(const Glib::RefPtr<Gdk::Pixbuf>& source) {
+  if (!source) return {};
+  auto result = source->copy();
+  gdk_pixbuf_saturate_and_pixelate(source->gobj(), result->gobj(), 0.0f, FALSE);
+  return result;
+}
+}  // namespace waybar::util
