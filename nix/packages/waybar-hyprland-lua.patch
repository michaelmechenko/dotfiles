+#pragma once
+
+#include <string>
+#include <optional>
+
+namespace waybar::util {
+inline std::optional<int> workspace_id(const std::string& name) {
+  if (name == "special") return -99;
+  try {
+    size_t consumed = 0;
+    const int id = std::stoi(name, &consumed);
+    if (consumed == name.size()) return id;
+  } catch (const std::exception&) {}
+  return std::nullopt;
+}
+
+inline std::string lua_quote(const std::string& value) {
+  std::string result = "\"";
+  for (unsigned char c : value) {
+    if (c == '"' || c == '\\') {
+      result += '\\';
+      result += c;
+    } else if (c < 32 || c == 127) {
+      result += '\\';
+      result += char('0' + c / 100);
+      result += char('0' + (c / 10) % 10);
+      result += char('0' + c % 10);
+    } else {
+      result += c;
+    }
+  }
+  return result + "\"";
+}
+
+inline std::string workspace_dispatch(int id, const std::string& name,
+                                      bool special, bool move_to_monitor) {
+  if (special) {
+    return "dispatch hl.dsp.workspace.toggle_special(" + lua_quote(id == -99 ? "" : name) + ")";
+  }
+  const auto selector = id > 0 ? std::to_string(id) : lua_quote("name:" + name);
+  return "dispatch hl.dsp.focus({ workspace = " + selector +
+         (move_to_monitor ? ", on_current_monitor = true" : "") + " })";
+}
+}  // namespace waybar::util
