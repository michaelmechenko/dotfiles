{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "accent-primary": "#d8647e",
    "accent-secondary": "#aeaed1",
    "accent-tertiary": "#bb9dbd",
    "accent-info": "#8ba9c1",
    "accent-warn": "#f5cb96"
  },
  "transient_prompt": {
    "template": "* ",
    "foreground": "p:accent-tertiary",
    "background": "transparent"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "options": {
            "cache_duration": "none"
          },
          "template": "\udb85\udd45 {{ if eq .UserName \"mishka\" }}{{ .UserName }}{{ else }}mm{{ end }} ",
          "foreground": "p:accent-secondary",
          "type": "session",
          "style": "plain"
        },
        {
          "options": {
            "cache_duration": "none",
            "max_depth": 3,
            "style": "agnoster_short"
          },
          "template": "\udb84\udf76 '{{ .Path }}' ",
          "foreground": "p:accent-primary",
          "type": "path",
          "style": "plain"
        },
        {
          "options": {
            "branch_icon": "",
            "cache_duration": "none"
          },
          "template": "<p:accent-warn>\udb84\udf75 '</>{{ .HEAD }}<p:accent-warn>' </>",
          "foreground": "p:accent-tertiary",
          "type": "git",
          "style": "plain"
        },
        {
          "options": {
            "always_enabled": false,
            "cache_duration": "none",
            "style": "austin",
            "threshold": 30000
          },
          "template": "{{ .FormattedMs }}",
          "foreground": "p:accent-info",
          "type": "executiontime",
          "style": "powerline"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "options": {
            "cache_duration": "none"
          },
          "template": "*",
          "type": "text",
          "style": "plain"
        }
      ],
      "newline": true
    }
  ],
  "version": 4,
  "final_space": true
}
