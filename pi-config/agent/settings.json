{
  "lastChangelogVersion": "0.84.2",
  "theme": "active",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "enabledModels": [
    "openai-codex/*",
    "ollama-cloud/*"
  ],
  "compaction": {
    "enabled": true
  },
  "enableInstallTelemetry": false,
  "defaultProjectTrust": "ask",
  "packages": [
    "npm:@dreki-gg/pi-lsp",
    "npm:pi-ast-grep",
    "npm:pi-mcp-adapter"
  ],
  "extensions": [
    "+extensions/titlebar-spinner/index.ts",
    "+extensions/plan-mode/index.ts",
    "+extensions/minimal-working-indicator/index.ts"
  ],
  "defaultThinkingLevel": "medium",
  "skills": [
    "-skills/tdd/SKILL.md",
    "-skills/terminate-slop/SKILL.md",
    "-skills/to-spec/SKILL.md",
    "-skills/to-tickets/SKILL.md",
    "-skills/code-review/SKILL.md",
    "-skills/triage/SKILL.md"
  ],
  "hideThinkingBlock": true,
  "quietStartup": false,
  "prompts": [
    "-prompts/implement-and-review.md",
    "-prompts/implement.md",
    "-prompts/scout-and-plan.md"
  ]
}