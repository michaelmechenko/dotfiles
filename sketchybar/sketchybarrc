PLUGIN_DIR="$CONFIG_DIR/plugins"

# Active palette colors (generated by `theme switch`).
source "$HOME/.config/theme/active/sketchybar/colors.sh"

# PERFORMANCE PROFILE — minimal bar, no AeroSpace integration.
# Active when /tmp/sketchybar_perf_mode exists (toggled by toggle_mode.sh / cmd-ctrl-alt-p).
# Shows only date and battery with blur_radius=0 on ALL displays (no display= key → SketchyBar
# default is `all`). AeroSpace callbacks are flag-gated while this profile is active.

chmod +x "$PLUGIN_DIR"/* 2>/dev/null

bar=(
  height=30
  blur_radius=0
  position=top
  color=$THEME_BAR_BG
  margin=0
  notch_display_height=38
  notch_offset=0
  sticky=false
  font_smoothing=on
  drawing=on
)

sketchybar --bar "${bar[@]}"

# Width is dynamic by default. Do not set width=dynamic here: SketchyBar 2.24.0 briefly
# converts that assignment to a fixed content width, which the first item can inherit.
default=(
  icon.font="CommitMono-m1v1:Regular:13"
  label.font="CommitMono-m1v1:Regular:13"
  icon.color=$THEME_BAR_TEXT
  label.color=$THEME_BAR_TEXT
  icon.padding_left=6
  icon.padding_right=6
)
sketchybar --default "${default[@]}"

# RIGHT BLOCK - Keep these as separate SketchyBar calls; batching causes overlap.
sketchybar --add item battery right \
    --set battery update_freq=60 label.padding_right=0 padding_right=0 label.color=$THEME_BAR_TEXT icon.drawing=off script="$PLUGIN_DIR/battery.sh"

sketchybar --add item sep_right right \
    --set sep_right icon="*-*-*" icon.y_offset=1 icon.padding_left=8 icon.padding_right=8 icon.color=$THEME_BAR_TEXT_INACTIVE label.drawing=off

sketchybar --add item date right \
    --set date update_freq=30 label.padding_right=2 label.color=$THEME_BAR_TEXT script="$PLUGIN_DIR/date.sh" icon.drawing=off

# Prime timer-only items immediately (see sketchybarrc.full for rationale).
NAME=date "$PLUGIN_DIR/date.sh"
NAME=battery "$PLUGIN_DIR/battery.sh"
