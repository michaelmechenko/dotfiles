#!/bin/sh

# Recreate tmux sessions/windows/panes from a file written by `tsave`.
# Sessions that already exist are skipped (additive). Pane geometry is restored
# via the saved window_layout string. Nothing is auto-resumed: a pane recorded
# with a Claude or pi session id gets an interactive y/N resume prompt typed
# into it (claude --resume <id> / pi --session <id>); a pane that was running
# nvim gets an informational cwd note (no reopen); any other notable foreground
# command gets a plain "last running here" note; plain shells get nothing.
#   usage: tload <name|path>

set -e
set -f

[ -n "$1" ] || { echo "usage: tload <name|path>" >&2; exit 2; }

if [ -r "$1" ]; then
    file="$1"
else
    file="$HOME/.config/tmux_sessions/$1.json"
fi
[ -r "$file" ] || { echo "tload: no such snapshot: $1" >&2; exit 1; }

expand_home() {
    case "$1" in
        "~") printf '%s' "$HOME" ;;
        "~/"*) printf '%s' "$HOME${1#\~}" ;;
        *) printf '%s' "$1" ;;
    esac
}

# Single-quote a value so it's safe to splice literally into a shell one-liner
# that gets typed into a pane via send-keys (not re-parsed by tload's own
# shell, so normal quoting rules don't apply automatically).
shquote() {
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

# Build the one-liner sent into a recreated pane instead of auto-running
# anything: claude/pi panes with a saved session id get an interactive y/N
# resume prompt (per-pane, non-blocking to tload itself); nvim panes get an
# informational note (no reopen — no reliable way to recover buffer state
# without a running nvim RPC server); any other non-shell foreground command
# gets a plain "last running here" note. Plain shells get nothing (unchanged).
pane_notice_cmd() {
    _csid="$1"; _psid="$2"; _cmd="$3"; _cwd="$4"
    if [ -n "$_csid" ]; then
        printf 'echo %s; if read -q '"'"'?Resume this session? (y/N) '"'"'; then echo; exec claude --resume %s; else echo; fi' \
            "$(shquote "last claude session here: $_csid")" "$(shquote "$_csid")"
    elif [ -n "$_psid" ]; then
        printf 'echo %s; if read -q '"'"'?Resume this session? (y/N) '"'"'; then echo; exec pi --session %s; else echo; fi' \
            "$(shquote "last pi session here: $_psid")" "$(shquote "$_psid")"
    elif [ "$_cmd" = "nvim" ]; then
        printf 'echo %s' "$(shquote "nvim was running here (cwd: $_cwd)")"
    else
        case "$_cmd" in
            ""|-|sh|bash|zsh|fish|dash) return 0 ;;
        esac
        printf 'echo %s' "$(shquote "last running here: $_cmd")"
    fi
}

# Restore order: float first (popup session the others may depend on), then saved order.
order=$(jq -r '.sessions | to_entries | sort_by(.value.name != "float") | .[].key' "$file")
for i in $order; do
    sp=".sessions[$i]"
    sname=$(jq -r "$sp.name" "$file")

    if tmux has-session -t "=$sname" 2>/dev/null; then
        printf 'skip: %s (exists)\n' "$sname"
        continue
    fi

    awin=$(jq -r "$sp.active_window" "$file")
    nwin=$(jq -r "$sp.windows | length" "$file")
    active_window_id=""

    w=0
    while [ "$w" -lt "$nwin" ]; do
        wp="$sp.windows[$w]"
        widx=$(jq -r "$wp.index" "$file")
        wname=$(jq -r "$wp.name" "$file")
        layout=$(jq -r "$wp.layout" "$file")
        apane=$(jq -r "$wp.active_pane" "$file")
        np=$(jq -r "$wp.panes | length" "$file")

        p0cwd=$(expand_home "$(jq -r "$wp.panes[0].cwd" "$file")")
        if [ "$w" -eq 0 ]; then
            first_pane=$(tmux new-session -d -s "$sname" -n "$wname" -c "$p0cwd" -P -F '#{pane_id}')
        else
            first_pane=$(tmux new-window -t "$sname:" -n "$wname" -c "$p0cwd" -P -F '#{pane_id}')
        fi

        if [ "$widx" = "$awin" ]; then
            active_window_id=$(tmux display-message -p -t "$first_pane" '#{window_id}')
        fi

        # Create remaining panes (geometry fixed afterward by select-layout).
        pane_ids="$first_pane"
        p=1
        while [ "$p" -lt "$np" ]; do
            pcwd=$(expand_home "$(jq -r "$wp.panes[$p].cwd" "$file")")
            npid=$(tmux split-window -t "$first_pane" -c "$pcwd" -P -F '#{pane_id}')
            pane_ids="$pane_ids $npid"
            p=$((p + 1))
        done

        [ "$np" -gt 1 ] && tmux select-layout -t "$first_pane" "$layout" >/dev/null 2>&1 || true

        # Relaunch commands and locate the active pane id by saved index.
        # Nothing auto-runs: claude/pi panes get an interactive resume prompt,
        # nvim/other notable panes get an informational note. See
        # pane_notice_cmd above.
        active_pane_id=""
        p=0
        for pane in $pane_ids; do
            csid=$(jq -r "$wp.panes[$p].claude_session // empty" "$file")
            psid=$(jq -r "$wp.panes[$p].pi_session // empty" "$file")
            cmd=$(jq -r "$wp.panes[$p].command" "$file")
            pcwd=$(expand_home "$(jq -r "$wp.panes[$p].cwd" "$file")")
            pidx=$(jq -r "$wp.panes[$p].index" "$file")
            [ "$pidx" = "$apane" ] && active_pane_id="$pane"
            notice=$(pane_notice_cmd "$csid" "$psid" "$cmd" "$pcwd")
            [ -n "$notice" ] && tmux send-keys -t "$pane" "$notice" C-m
            p=$((p + 1))
        done
        [ -n "$active_pane_id" ] && tmux select-pane -t "$active_pane_id" >/dev/null 2>&1 || true

        w=$((w + 1))
    done

    [ -n "$active_window_id" ] && tmux select-window -t "$active_window_id" >/dev/null 2>&1 || true
    printf 'loaded: %s\n' "$sname"
done

# If invoked outside tmux, attach to the first non-float session (avoid landing in the popup).
if [ -z "$TMUX" ]; then
    first=$(jq -r 'first(.sessions[] | select(.name != "float") | .name) // (.sessions[0].name) // empty' "$file")
    [ -n "$first" ] && tmux has-session -t "=$first" 2>/dev/null && exec tmux attach -t "$first"
fi
