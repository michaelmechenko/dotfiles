#!/usr/bin/env bash
# Compatibility wrapper: M-P/M-S-P and existing sidebar callers open the exact
# selected agent's plan. Missing Pi plans never fall back to responses.
cur=${1:-$(tmux display -p '#{pane_id}')}
expected_agent=${2:-}
expected_session=${3:-}
# Preserve the legacy <pane> <session> form for direct Claude callers.
if [ -z "$expected_session" ] && [ -n "$expected_agent" ] && [ "$expected_agent" != claude ] && [ "$expected_agent" != pi ]; then
  expected_session=$expected_agent
  expected_agent=claude
fi
exec "$HOME/.config/tmux_scripts/tmux-agent-action" plan "$cur" "$expected_agent" "$expected_session"
