#!/usr/bin/env bash
# tmux-agent-ls -- emit one TSV row per live AI-agent pane (Claude Code + pi),
# schema-compatible so the mm-sidebar agents glance and the M-b menu can consume
# both from one stream.
#
# 9 fields:
#   sessionId <TAB> pane_id <TAB> target <TAB> session_name <TAB> state <TAB>
#   name <TAB> transcript <TAB> window_name <TAB> agent
#   agent ∈ claude | pi
#   state ∈ awaiting-permission | waiting | thinking | idle
#
# This is now a thin wrapper over `mm-sidebar agents`, which owns the only
# implementation of the join. The shell version this replaced forked
# tmux-pi-session once per pane (pgrep + ps x2 + lsof + sed + ls + basename each)
# and measured 1.26-1.44s on a 20-pane machine -- around a second of which was
# spent proving that panes are NOT running pi. The Go version batches the process
# table and cwd lookups into one call apiece and caches identities across sweeps:
# ~0.10s cold, and inside the sidebar the cached path skips the process table
# entirely (~0.02s). Verified byte-identical output against the shell version.
#
# Do NOT reimplement the join here. If it needs changing, change
# tmux_scripts/mm-sidebar/internal/agents and both this script and the sidebar
# pick it up together -- that single-source property is the point of the wrapper.

set -uo pipefail

CLAUDE_LS="$HOME/.config/tmux_scripts/tmux-claude-ls"
BUILD="$HOME/.config/tmux_scripts/tmux-sidebar-build"

if bin=$("$BUILD" 2>/dev/null) && [ -n "$bin" ]; then
  exec "$bin" agents
fi

# Degraded fallback: no Go toolchain, or the build failed. Emit Claude rows only,
# by re-tagging tmux-claude-ls's own output -- it already computes the identical
# first 8 fields and ends in statusUpdatedAt, which is dropped and replaced by the
# literal "claude" agent tag so rows keep the 9-field shape consumers parse.
#
# pi rows are lost in this mode. That is deliberate: the alternative is keeping a
# second copy of the pi detection recipe in shell, which is exactly the drift this
# wrapper exists to prevent. A missing pi row degrades a glance; a stale duplicate
# recipe silently reports wrong state.
if [ -x "$CLAUDE_LS" ]; then
  "$CLAUDE_LS" 2>/dev/null | awk -F'\t' 'NF>=9 {
    out=$1; for (i=2;i<=8;i++) out=out"\t"$i
    print out "\tclaude"
  }'
fi
