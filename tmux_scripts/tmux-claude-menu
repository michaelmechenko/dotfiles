#!/usr/bin/env bash
# Cross-tmux Claude + Pi agent menu (bound to M-b). Rows are sorted actionable-first
# (permission > waiting > thinking > idle) with a relative activity age per row.
#   enter -> focus that session's pane (across any tmux session)
#   k     -> approve ALL waiting/permission sessions (send Enter to each)
#   M-p/M-P/M-G -> prompt/plan/response for selected Claude or Pi
#   C-s -> send a typed message; C-y/C-x -> Claude-only approve/kill
# Colors keyed off COLORS.md roles: rose=permission/waiting, dusty_pink=thinking, inactive=idle.

SELF="$HOME/.config/tmux_scripts/tmux-claude-menu"
LS="$HOME/.config/tmux_scripts/tmux-agent-ls"

session_matches() {
  local sid="$1" pane="$2" agent="${3:-}" states="${4:-}" pane_pid info actual
  if [ "$agent" = pi ]; then
    pane_pid=$(tmux display -p -t "$pane" '#{pane_pid}' 2>/dev/null) || return 1
    info=$("$HOME/.config/tmux_scripts/tmux-pi-session" --exact "$pane_pid" 2>/dev/null) || return 1
    actual=$(printf '%s' "$info" | awk -F '\t' '{print $4}')
    [ "$actual" = "$sid" ]
    return
  fi
  "$LS" | awk -F'\t' -v sid="$sid" -v pane="$pane" -v agent="$agent" -v states="$states" '
    $1 == sid && $2 == pane && (agent == "" || $9 == agent) && (states == "" || index("|" states "|", "|" $5 "|") > 0) { found=1 }
    END { exit(found ? 0 : 1) }'
}

hex_rgb() {
  local hex=${1#\#}
  printf '%d;%d;%d' "$((16#${hex:0:2}))" "$((16#${hex:2:2}))" "$((16#${hex:4:2}))"
}

case "${1:-}" in
  --colorize)
    # Emit fzf rows sorted actionable-first via a leading composite key
    # (prio, then oldest-activity first); the key is stripped by `cut` after sort.
    primary=$(tmux show-options -gqv @color-accent-primary); primary=${primary:-#d8647e}
    tertiary=$(tmux show-options -gqv @color-accent-tertiary); tertiary=${tertiary:-#bb9dbd}
    muted=$(tmux show-options -gqv @color-text-muted); muted=${muted:-#656a80}
    "$LS" | awk -F'\t' \
      -v primary="$(hex_rgb "$primary")" -v tertiary="$(hex_rgb "$tertiary")" -v muted="$(hex_rgb "$muted")" '
    BEGIN { ESC = sprintf("%c", 27); RST = ESC "[0m" }
    {
      sid=$1; pane=$2; target=$3; sname=$4; state=$5; name=$6; tr=$7; wname=$8; agent=$9;
      if (state == "awaiting-permission") { c = primary;  tag = "PERMISSION"; prio = 0 }
      else if (state == "waiting")        { c = primary;  tag = "WAITING";    prio = 1 }
      else if (state == "thinking")       { c = tertiary; tag = "thinking";   prio = 2 }
      else                                { c = muted;    tag = "idle";       prio = 3 }
      loc = wname " · " sname;
      if (name != "-") loc = loc " · " name;
      pre  = ESC "[38;2;" c "m";
      disp = sprintf("%s● %-7s %-10s %s%s", pre, agent, tag, loc, RST);
      printf "%d\t%s\t%s\t%s\t%s\t%s\t%s\n", prio, disp, pane, target, sid, tr, agent;
    }' | sort -t"$(printf '\t')" -k1,1n | cut -f2-
    exit 0 ;;

  --preview)
    agent="$2"; tr="$3"
    [ -f "$tr" ] || { echo "(no transcript)"; exit 0; }
    if [ "$agent" = claude ]; then
      q=$(jq -rs '[.[] | select(.type == "user" or (.type == "message" and .message.role == "user")) | (.message // .) | .content | if type == "array" then [ .[] | select(.type == "text") | .text ] | join("\n") elif type == "string" then . else "" end | select(length > 0)] | last // empty' "$tr" 2>/dev/null)
      a=$(jq -rs '[.[] | select(.type == "assistant" or (.type == "message" and .message.role == "assistant")) | (.message // .) | [ .content[]? | select(.type == "text") | .text ] | join("\n") | select(length > 0)] | last // empty' "$tr" 2>/dev/null)
    else
      q=$(jq -rs '[.[] | select(.type == "message" and .message.role == "user") | .message.content | if type == "array" then [ .[] | select(.type == "text") | .text ] | join("\n") elif type == "string" then . else "" end | select(length > 0)] | last // empty' "$tr" 2>/dev/null)
      a=$(jq -rs '[.[] | select(.type == "message" and .message.role == "assistant") | [ .message.content[]? | select(.type == "text") | .text ] | join("\n") | select(length > 0)] | last // empty' "$tr" 2>/dev/null)
    fi
    {
      [ -n "$q" ] && printf '## you\n\n%s\n\n' "$q"
      [ -n "$a" ] && printf '## %s\n\n%s\n' "$agent" "$a"
    } | bat -l md --color=always --style=plain --paging=never --theme=ansi \
        --terminal-width="${FZF_PREVIEW_COLUMNS:-80}"
    exit 0 ;;

  --act)
    action="$2"; sid="$3"; pane="$4"; agent="$5"
    # Approval and destructive menu actions retain their Claude-only contract.
    [ "$agent" = claude ] || exit 0
    case "$action" in
      approve)
        session_matches "$sid" "$pane" claude 'awaiting-permission|waiting' || exit 0
        tmux send-keys -t "$pane" Enter ;;
      kill)
        session_matches "$sid" "$pane" claude || exit 0
        tmux kill-pane -t "$pane" ;;
      *) exit 2 ;;
    esac
    exit 0 ;;

  --accept-all)
    printf 'approve all waiting sessions? [y/N] '
    IFS= read -r answer
    case "$answer" in y|Y|yes|YES) ;; *) exit 0 ;; esac
    while IFS=$'\t' read -r sid pane; do
      [ -n "$sid" ] && "$SELF" --act approve "$sid" "$pane" claude
    done < <("$LS" | awk -F'\t' '$9=="claude" && ($5=="awaiting-permission" || $5=="waiting") {print $1 "\t" $2}')
    exit 0 ;;

  --send)
    # Send a typed line to the selected session's pane. Invoked via fzf `execute`.
    sid="$2"; pane="$3"; agent="$4"
    [ -n "$sid" ] && [ -n "$pane" ] || exit 0
    printf 'msg> '
    IFS= read -r msg
    if [ -n "$msg" ] && session_matches "$sid" "$pane" "$agent"; then
      tmux send-keys -t "$pane" -l "$msg"
      tmux send-keys -t "$pane" Enter
    fi
    exit 0 ;;

  --inner)
    out=$("$SELF" --colorize | fzf --ansi --delimiter='\t' --with-nth=1 \
      --no-sort --layout=reverse-list --cycle --prompt='agents > ' \
      --header=$'enter focus · M-p prompt · M-P plan · M-G response · C-s send\nClaude only: k approve-all · C-y approve · C-x kill · esc close' \
      --preview "$SELF --preview {6} {5}" \
      --preview-window 'right,58%,wrap,follow,+999999,<80(down,55%)' --preview-wrap-sign='' \
      --bind "tab:down,btab:up,ctrl-j:down,ctrl-k:up,alt-j:down,alt-k:up,ctrl-d:preview-half-page-down,ctrl-u:preview-half-page-up,alt-n:preview-half-page-down,alt-u:preview-half-page-up,alt-q:abort,alt-b:abort,alt-p:execute-silent($HOME/.config/tmux_scripts/tmux-agent-action prompt {2} {6} {4})+abort,alt-P:execute-silent($HOME/.config/tmux_scripts/tmux-agent-action plan {2} {6} {4})+abort,alt-G:execute-silent($HOME/.config/tmux_scripts/tmux-agent-action response {2} {6} {4})+abort,k:execute($SELF --accept-all)+reload($SELF --colorize),ctrl-y:execute-silent($SELF --act approve {4} {2} {6})+reload($SELF --colorize),ctrl-s:execute($SELF --send {4} {2} {6})+reload($SELF --colorize),ctrl-x:execute-silent($SELF --act kill {4} {2} {6})+reload($SELF --colorize)")
    [ -n "$out" ] || exit 0
    pane=$(printf '%s' "$out" | cut -f2)
    target=$(printf '%s' "$out" | cut -f3)
    if [ -n "$target" ]; then
      if [ -n "${ORIGIN_CLIENT:-}" ]; then
        tmux switch-client -c "$ORIGIN_CLIENT" -t "$target"
      else
        tmux switch-client -t "$target"
      fi
    fi
    [ -n "$pane" ] && tmux select-pane -t "$pane"
    exit 0 ;;

  *)
    origin=$(tmux display -p '#{client_name}')
    border=$(tmux show -gqv @color-text-muted); [ -n "$border" ] || border="#a9b1d6"
    tmux display-popup -E -w 80% -h 70% -b rounded -S "fg=$border" \
      "ORIGIN_CLIENT='$origin' '$SELF' --inner"
    ;;
esac
