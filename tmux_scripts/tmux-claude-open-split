#!/usr/bin/env bash
# Open a file in an nvim split, always to the right (never below):
#   1 pane            -> new pane to the right.
#   2+ panes          -> new pane above the rightmost pane (stacked atop the right column).
temporary=false
if [ "${1:-}" = "--temporary" ]; then
  temporary=true
  shift
fi
f="$1"
origin=${2:-$(tmux display -p '#{pane_id}')}
# tmux runs the split command via `sh -c`; shell-quote the path defensively.
printf -v q '%q' "$f"
cmd="nvim -- $q"
$temporary && cmd="cleanup() { rm -f -- $q; }; trap cleanup EXIT; trap 'exit 129' HUP; trap 'exit 130' INT; trap 'exit 143' TERM; nvim -c 'setfiletype markdown' -- $q"
pane_rows=$(tmux list-panes -t "$origin" -F $'#{pane_left}\t#{pane_id}\t#{@sidebar_pane}') || exit 1
panes=$(printf '%s\n' "$pane_rows" | awk -F '\t' '$3 != 1 && $2 != "" { count++ } END { print count + 0 }')
if [ "${panes:-0}" -le 1 ]; then
  tmux split-window -h -t "$origin" "$cmd"
else
  rp=$(printf '%s\n' "$pane_rows" | awk -F '\t' '$3 != 1 && $1 >= best { best=$1; pane=$2 } END { print pane }')
  [ -n "$rp" ] || exit 1
  tmux split-window -v -b -t "$rp" "$cmd"
fi
