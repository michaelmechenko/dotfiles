#!/usr/bin/env zsh

set -e

# Private popup process: all caller-controlled values arrive as environment data,
# then become individual new-session argv elements. The shell command stays fixed.
if [ "${1:-}" = "--inner" ]; then
    exec tmux new-session -s nnn \
        -e "NNN_ORIGIN_PANE=$NNN_ORIGIN_PANE" \
        -e "NNN_PLUG=$NNN_PLUG" \
        -e "NNN_SPLIT=$NNN_SPLIT" \
        -e "NNN_SPLITSIZE=$NNN_SPLITSIZE" \
        -e "NNN_BATSTYLE=$NNN_BATSTYLE" \
        -e "NNN_BATTHEME=$NNN_BATTHEME" \
        -e "NNN_COLORS=$NNN_COLORS" \
        -e "NNN_FCOLORS=$NNN_FCOLORS" \
        -e "NNN_PAGER=$NNN_PAGER" \
        -e "NNN_MUTED_HEX=$NNN_MUTED_HEX" \
        -e "FZF_DEFAULT_OPTS=$FZF_DEFAULT_OPTS" \
        -e "RG_COLORS=$RG_COLORS" \
        -c "$NNN_CWD" 'exec nnn -aH -l 1 -P p'
fi

# Placement mode: float (M-d) is centred; pane (M-B) overlays the launcher.
MODE="${1:-float}"
if [ "$(tmux display-message -p '#{session_name}')" = "nnn" ]; then
    tmux kill-session -t nnn
    exit 0
fi

chmod +x "$HOME"/.config/nnn/plugins/* "$HOME"/.config/nnn/plugins/.nnn-tmux-split "$HOME"/.config/nnn/plugins/.nnn-open-origin 2>/dev/null

ORIGIN_PANE="$(tmux display-message -p '#{pane_id}')"
CWD="$(tmux display-message -p '#{pane_current_path}')"
PANE_W="$(tmux display-message -p '#{pane_width}')"
PANE_H="$(tmux display-message -p '#{pane_height}')"
BORDER_COLOR=$(tmux show-options -gqv @color-text-muted)
BORDER_COLOR=${BORDER_COLOR:-"#a9b1d6"}
PRIMARY_COLOR=$(tmux show-options -gqv @color-accent-primary)
PRIMARY_COLOR=${PRIMARY_COLOR:-"#d8647e"}
hex_rgb() {
    local hex=${1#\#}
    printf '%d,%d,%d' "$((16#${hex[1,2]}))" "$((16#${hex[3,4]}))" "$((16#${hex[5,6]}))"
}

PLUG='l:tmux-split-h;j:tmux-split-v;e:tmux-newwindow;i:cd-origin;p:preview-tui;f:fzcd;g:fzrg;w:toggle-wrap;h:tmux-help'
COLORS='63256325'
FCOLORS='060606020005030801050201'
SPLITSIZE=70
if [ "$MODE" = "float" ]; then
    CLIENT_W="$(tmux display-message -p '#{client_width}')"
    if [ "$CLIENT_W" -ge 160 ] 2>/dev/null; then NNN_SPLIT=v; else NNN_SPLIT=h; fi
else
    NNN_SPLIT=v
fi
BATSTYLE=numbers
BATTHEME=ansi

MUTED_RGB=${BORDER_COLOR#\#}
if command -v moor >/dev/null 2>&1; then
    PAGER_CMD="moor --no-linenumbers --mousemode=scroll --statusbar=plain --scroll-left-hint=ESC[38;2;$((16#${MUTED_RGB[1,2]}));$((16#${MUTED_RGB[3,4]}));$((16#${MUTED_RGB[5,6]}))m<ESC[39m --scroll-right-hint=ESC[38;2;$((16#${MUTED_RGB[1,2]}));$((16#${MUTED_RGB[3,4]}));$((16#${MUTED_RGB[5,6]}))m>ESC[39m"
else
    PAGER_CMD='less -R --mouse --wheel-lines=1 -+F'
fi

FZF_OPTS="${FZF_DEFAULT_OPTS:-}"
if [ -z "$FZF_OPTS" ]; then
    FZF_OPTS=$(tmux show-environment -g FZF_DEFAULT_OPTS 2>/dev/null || true)
    FZF_OPTS=${FZF_OPTS#FZF_DEFAULT_OPTS=}
fi
RG_THEME_COLORS="${RG_COLORS:-match:fg:$(hex_rgb "$PRIMARY_COLOR"):style:underline}"

tmux kill-session -t nnn 2>/dev/null || true
if [ "$MODE" = "pane" ]; then
    GEO=(-t "$ORIGIN_PANE" -x '#{popup_pane_left}' -y '#{popup_pane_bottom}' -w "$PANE_W" -h "$PANE_H")
else
    GEO=(-xC -yC -w65% -h75%)
fi

SELF=${0:A}
tmux popup "${GEO[@]}" -S "fg=$BORDER_COLOR" -E \
    -e "NNN_ORIGIN_PANE=$ORIGIN_PANE" \
    -e "NNN_CWD=$CWD" \
    -e "NNN_PLUG=$PLUG" \
    -e "NNN_SPLIT=$NNN_SPLIT" \
    -e "NNN_SPLITSIZE=$SPLITSIZE" \
    -e "NNN_BATSTYLE=$BATSTYLE" \
    -e "NNN_BATTHEME=$BATTHEME" \
    -e "NNN_COLORS=$COLORS" \
    -e "NNN_FCOLORS=$FCOLORS" \
    -e "NNN_PAGER=$PAGER_CMD" \
    -e "NNN_MUTED_HEX=$BORDER_COLOR" \
    -e "FZF_DEFAULT_OPTS=$FZF_OPTS" \
    -e "RG_COLORS=$RG_THEME_COLORS" \
    "$SELF --inner" || true
