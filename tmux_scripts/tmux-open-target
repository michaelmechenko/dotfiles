#!/usr/bin/env bash
# Shared selected-target adapter.
#
# Legacy (extrakto / nnn / sidebar / shell Ctrl-T):
#   tmux-open-target <selection> [line]
# Explicit (tmux-open-picker):
#   tmux-open-target <open|copy|finder|nvim> <pane> <target> [line]
#
# Explicit callers get synchronous status and stderr. Legacy callers retain the
# historical open behavior and $TMUX_OPEN_PANE origin fallback.

ACTIONS="open copy finder nvim"
is_action() { case "$1" in open|copy|finder|nvim) return 0 ;; *) return 1 ;; esac; }
die() { printf 'tmux-open-target: %s\n' "$*" >&2; return 2; }
dry() { [ "${OPEN_TARGET_DRY_RUN:-0}" = "1" ]; }

open_path() {
  if [ "$(uname -s)" = Darwin ]; then open "$1"; else xdg-open "$1"; fi
}
reveal_path() {
  if [ "$(uname -s)" = Darwin ]; then
    [ -f "$1" ] && open -R "$1" || open "$1"
  elif [ -f "$1" ] && command -v dolphin >/dev/null 2>&1; then
    dolphin --select "$1"
  else
    xdg-open "$1"
  fi
}
copy_path() {
  if command -v pbcopy >/dev/null 2>&1; then pbcopy; else wl-copy; fi
}

pane_cwd() { tmux display -p -t "$1" '#{pane_current_path}'; }

require_pane() {
  local pane="$1" cwd
  cwd=$(pane_cwd "$pane" 2>/dev/null) || { die "invalid pane: $pane"; return 1; }
  [ -n "$cwd" ] || { die "invalid pane: $pane"; return 1; }
}

# resolve <target> <pane> -> RPATH (absolute/canonical when local), KIND
resolve() {
  local target="$1" pane="$2" cwd path
  cwd=$(pane_cwd "$pane") || return
  case "$target" in
    '~') target="$HOME" ;;
    '~/'*) target="$HOME/${target#\~/}" ;;
  esac
  case "$target" in
    *://*) KIND=url; RPATH="$target"; return ;;
  esac
  case "$target" in
    /*) path="$target" ;;
    *) path="$cwd/$target" ;;
  esac
  if [ -d "$path" ]; then KIND=dir; RPATH="$path"; return; fi
  if [ -f "$path" ]; then KIND=file; RPATH="$path"; return; fi
  KIND=other; RPATH="$target"
}

# 1 pane: split right. Otherwise stack above the rightmost pane, matching
# tmux-claude-open-split. target is shell-quoted because tmux receives a command
# string; -- protects paths beginning with a dash.
nvim_split() {
  local pane="$1" target="$2" line="${3:-}" cwd npanes rightmost quoted command
  case "$line" in ''|*[!0-9]*) [ -z "$line" ] || { die "invalid line: $line"; return 1; } ;; esac
  cwd=$(pane_cwd "$pane") || { die "invalid pane: $pane"; return 1; }
  printf -v quoted '%q' "$target"
  if [ -n "$line" ]; then command="nvim +$line -- $quoted"; else command="nvim -- $quoted"; fi
  npanes=$(tmux display -p -t "$pane" '#{window_panes}') || { die "invalid pane: $pane"; return 1; }
  if [ "${npanes:-1}" -le 1 ]; then
    if dry; then printf 'split-window -h -t %s -c %q %s\n' "$pane" "$cwd" "$command"; return; fi
    tmux split-window -h -t "$pane" -c "$cwd" "$command"
  else
    rightmost=$(tmux list-panes -t "$pane" -F '#{pane_left} #{pane_id}' | sort -n | tail -1 | cut -d' ' -f2) || return
    [ -n "$rightmost" ] || { die "cannot locate split target"; return 1; }
    if dry; then printf 'split-window -v -b -t %s -c %q %s\n' "$rightmost" "$cwd" "$command"; return; fi
    tmux split-window -v -b -t "$rightmost" -c "$cwd" "$command"
  fi
}

do_open() {
  local pane="$1" target="$2" line="${3:-}"
  resolve "$target" "$pane" || return
  case "$KIND" in
    file) nvim_split "$pane" "$RPATH" "$line" ;;
    dir|url|other) if dry; then printf 'open %q\n' "$RPATH"; else open_path "$RPATH"; fi ;;
  esac
}

do_nvim() {
  local pane="$1" target="$2" line="${3:-}"
  resolve "$target" "$pane" || return
  case "$KIND" in
    file|dir) nvim_split "$pane" "$RPATH" "$line" ;;
    *) die "nvim requires a filesystem target"; return 1 ;;
  esac
}

do_finder() {
  local pane="$1" target="$2"
  resolve "$target" "$pane" || return
  case "$KIND" in
    file) if dry; then printf 'open -R %q\n' "$RPATH"; else reveal_path "$RPATH"; fi ;;
    dir) if dry; then printf 'open %q\n' "$RPATH"; else reveal_path "$RPATH"; fi ;;
    *) die "finder requires a filesystem target"; return 1 ;;
  esac
}

do_copy() {
  local pane="$1" target="$2"
  resolve "$target" "$pane" || return
  if dry; then printf 'printf %%s %q | pbcopy\n' "$RPATH"; else printf '%s' "$RPATH" | copy_path; fi
}

explicit() {
  local action="$1" pane="$2" target="$3" line="${4:-}"
  is_action "$action" || { die "unsupported action: $action"; return 1; }
  require_pane "$pane" || return
  case "$line" in ''|*[!0-9]*) [ -z "$line" ] || { die "invalid line: $line"; return 1; } ;; esac
  case "$action" in
    open) do_open "$pane" "$target" "$line" ;;
    copy) do_copy "$pane" "$target" ;;
    finder) do_finder "$pane" "$target" ;;
    nvim) do_nvim "$pane" "$target" "$line" ;;
  esac
}

main() {
  # Explicit mode is selected only by a recognized action. Do not infer it from
  # a pane-looking second legacy word: Ctrl-T and older callers may join an
  # arbitrary multi-word selection, which must retain legacy semantics.
  if [ "$#" -ge 3 ] && is_action "$1"; then
    explicit "$1" "$2" "$3" "${4:-}"
    return
  fi
  # Legacy: join all arguments so Ctrl-T selections containing spaces remain a
  # single target. A two-argument legacy invocation keeps its :line contract.
  local selection="$*" line="" pane
  if [ "$#" -eq 2 ]; then selection="$1"; line="$2"; fi
  pane="${EXTRAKTO_ORIGIN_PANE:-${TMUX_OPEN_PANE:-}}"
  [ -n "$pane" ] || pane=$(tmux display -p '#{pane_id}' 2>/dev/null)
  [ -n "$pane" ] || { die "invalid pane"; return 1; }
  do_open "$pane" "$selection" "$line"
}

main "$@"
