#!/bin/sh

# Move a pane into its OWN new window — the crash-safe replacement for
# `break-pane`. The installed tmux (Homebrew --HEAD "3.7", commit 705fbf9)
# crashes the *entire server* on break-pane, so we never call it. Instead:
# create a detached placeholder window with the target session's usual placement
# (or immediately after an explicitly supplied window),
# join-pane the pane into it, then kill the placeholder so the pane is left
# alone in the new window. (new-window / join-pane / kill-pane do not crash.)
# Prints the new window id. Revert callers to a plain `break-pane` once tmux is
# on a build whose break-pane works.
#
# Usage: tmux-pane-to-new-window <pane-id> [target-session] [window-name] [after-window]
#   <pane-id>        pane to move, e.g. %5
#   [target-session] session id/name for the new window (default: pane's session)
#   [window-name]    if non-empty, name the window (rename-window pins
#                    automatic-rename off)
#   [after-window]   opt-in insertion after this window in the target session;
#                    omitted callers retain their existing placement behavior

set -e

pane="${1:?pane id required}"
target="${2:-}"
name="${3:-}"
after="${4:-}"
source_session="$(tmux display-message -t "$pane" -p '#{session_id}')"
[ -n "$source_session" ] || exit 1
[ -n "$target" ] || target="$source_session"

# Capture both stable IDs from the detached placeholder. Never continue with
# empty IDs after a failed creation: that could target an unrelated active pane.
if [ -n "$after" ]; then
    created="$(tmux new-window -a -d -P -F '#{window_id} #{pane_id}' -t "${target}:$after")"
else
    created="$(tmux new-window -d -P -F '#{window_id} #{pane_id}' -t "${target}:")"
fi
set -- $created
[ "$#" -eq 2 ] || exit 1
newwin="$1"
placeholder="$2"

if ! tmux join-pane -s "$pane" -t "$newwin"; then
    # Remove only this invocation's placeholder; the source pane never moved.
    tmux kill-pane -t "$placeholder" 2>/dev/null || true
    exit 1
fi
tmux kill-pane -t "$placeholder"         # leave only the moved pane

if [ -n "$name" ]; then
    tmux rename-window -t "$newwin" "$name"
fi

printf '%s\n' "$newwin"
