#!/usr/bin/env bash
# Open the current pane's pi session's last assistant response in an nvim
# split (side placement via tmux-claude-open-split — generic despite the
# name, it just opens a given file to the right).
#
# pi has no live pid-keyed session-state file like Claude Code's
# claude/sessions/<pid>.json, so the session is located by process tree +
# cwd instead: the pane's direct `pi` child process's cwd (via lsof) is
# slugged the same way as pi's own sessions/<slug> dirs (/ and . -> -), and
# the most recently modified *.jsonl in that dir is treated as the active
# session.

origin=$(tmux display -p '#{pane_id}')
pane_pid=$(tmux display -p -t "$origin" '#{pane_pid}')

pi_pid=$(pgrep -P "$pane_pid" -x pi 2>/dev/null | head -1)
[ -n "$pi_pid" ] || { tmux display-message "no pi session in this pane"; exit 0; }

cwd=$(lsof -a -p "$pi_pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | tail -1)
[ -n "$cwd" ] || { tmux display-message "couldn't resolve pi session cwd"; exit 0; }

tmp="${cwd//\//-}"
slug="${tmp//./-}"
sess_dir="$HOME/.config/pi-config/agent/sessions/$slug"
[ -d "$sess_dir" ] || { tmux display-message "no pi sessions for $cwd"; exit 0; }

transcript=$(ls -t "$sess_dir"/*.jsonl 2>/dev/null | head -1)
[ -f "$transcript" ] || { tmux display-message "no pi transcript found"; exit 0; }

out="$(mktemp -t pi-resp).md"
jq -c 'select(.type=="message" and .message.role=="assistant")' "$transcript" 2>/dev/null | tail -1 \
  | jq -r '.message.content[]? | select(.type=="text") | .text' 2>/dev/null > "$out"
[ -s "$out" ] || printf '(no text response found)\n' > "$out"

"$HOME/.config/tmux_scripts/tmux-claude-open-split" "$out"
