#!/usr/bin/env bash
# Open the current pane's pi session's last assistant response in an nvim
# split (side placement via tmux-claude-open-split — generic despite the
# name, it just opens a given file to the right).
#
# tmux-pi-session resolves only Pi's PID-keyed session-state registry here, so
# this action never guesses from cwd or a newest transcript shared by another process.

origin=${1:-$(tmux display -p '#{pane_id}')}
expected_agent=${2:-}
expected_session=${3:-}
# Keep the optional <pane> <session> form for direct callers while sidebar
# actions pass <pane> <agent> <session>.
if [ -z "$expected_session" ] && [ -n "$expected_agent" ] && [ "$expected_agent" != "pi" ]; then
  expected_session=$expected_agent
  expected_agent=pi
fi
[ -z "$expected_agent" ] || [ "$expected_agent" = "pi" ] || {
  tmux display-message "agent session changed"
  exit 0
}
pane_pid=$(tmux display -p -t "$origin" '#{pane_pid}')

info=$("$HOME/.config/tmux_scripts/tmux-pi-session" --exact "$pane_pid" 2>/dev/null) || {
  tmux display-message "no pi session in this pane"
  exit 0
}

pid=$(printf '%s' "$info" | awk -F '\t' '{print $1}')
transcript=$(printf '%s' "$info" | awk -F '\t' '{print $3}')
session_id=$(printf '%s' "$info" | awk -F '\t' '{print $4}')
case "$expected_session" in
  pi:*) actual_session="pi:$pid" ;; # legacy resolver identity
  *) actual_session="$session_id" ;;
esac
[ -z "$expected_session" ] || [ "$actual_session" = "$expected_session" ] || {
  tmux display-message "agent session changed"
  exit 0
}

out=$(mktemp "${TMPDIR:-/tmp}/pi-resp.XXXXXX") || {
  tmux display-message "could not create response file"
  exit 1
}
if ! jq -rs '
  [ .[]
    | select(.type == "message" and .message.role == "assistant")
    | [ .message.content[]? | select(.type == "text") | .text ] | join("\n")
    | select(length > 0)
  ] | last // empty
' "$transcript" > "$out" 2>/dev/null; then
  rm -f -- "$out"
  tmux display-message "could not read pi response"
  exit 1
fi
[ -s "$out" ] || printf '(no text response found)\n' > "$out"

"$HOME/.config/tmux_scripts/tmux-claude-open-split" --temporary "$out" "$origin" || rm -f -- "$out"
