#!/usr/bin/env bash
# Open the current pane's pi session's last assistant response in an nvim
# split (side placement via tmux-claude-open-split — generic despite the
# name, it just opens a given file to the right).
#
# tmux-pi-session prefers pi's PID-keyed session-state registry, so it opens
# the exact transcript for this process. Unreloaded older pi processes degrade
# explicitly to its legacy cwd -> newest-transcript fallback.

origin=$(tmux display -p '#{pane_id}')
pane_pid=$(tmux display -p -t "$origin" '#{pane_pid}')

info=$($HOME/.config/tmux_scripts/tmux-pi-session "$pane_pid" 2>/dev/null) || {
  tmux display-message "no pi session in this pane"
  exit 0
}

transcript=$(printf '%s' "$info" | awk -F '\t' '{print $3}')

out="$(mktemp -t pi-resp).md"
jq -c 'select(.type=="message" and .message.role=="assistant")' "$transcript" 2>/dev/null | tail -1 \
  | jq -r '.message.content[]? | select(.type=="text") | .text' 2>/dev/null > "$out"
[ -s "$out" ] || printf '(no text response found)\n' > "$out"

"$HOME/.config/tmux_scripts/tmux-claude-open-split" "$out"
