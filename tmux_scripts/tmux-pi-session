#!/bin/sh
# Resolve the pi process and newest transcript for a tmux pane.
# Output: pid<TAB>cwd<TAB>transcript<TAB>session_id

set -f

pane_pid=${1:-}
[ -n "$pane_pid" ] || exit 2

PI_SESS_DIR="$HOME/.config/pi-config/agent/sessions"

for candidate in $(pgrep -P "$pane_pid" 2>/dev/null || true); do
    comm=$(ps -o comm= -p "$candidate" 2>/dev/null | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    args=$(ps -ww -o args= -p "$candidate" 2>/dev/null | sed 's/^[[:space:]]*//')

    # Recent pi releases set their process name to pi. Older/current Node
    # launches may retain node, so identify the CLI by its package path too.
    case "$comm:$args" in
        pi:*|*:*/pi-coding-agent/dist/cli.js*) ;;
        *) continue ;;
    esac

    cwd=$(lsof -a -p "$candidate" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | tail -1)
    [ -n "$cwd" ] || exit 1

    slug="--$(printf '%s' "${cwd#/}" | tr '/' '-')--"
    sess_dir="$PI_SESS_DIR/$slug"
    [ -d "$sess_dir" ] || exit 1

    transcript=$( (set +f; ls -t "$sess_dir"/*.jsonl 2>/dev/null | head -1) )
    [ -f "$transcript" ] || exit 1

    session_id=$(basename "$transcript" .jsonl | sed 's/^.*_//')
    printf '%s\t%s\t%s\t%s\n' "$candidate" "$cwd" "$transcript" "$session_id"
    exit 0
done

exit 1

# Diagnostic usage:
#   tmux_scripts/tmux-pi-session <pane_pid>
# It exits 0 and prints the resolved process/cwd/transcript/session id for pi,
# and exits 1 for a non-pi pane or a pane without a transcript.
