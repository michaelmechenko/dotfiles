#!/bin/sh
# tmux-sidebar-build -- ensure the mm-sidebar binary is built, print its path.
#
# mm-sidebar is this repo's only compiled component. The binary is deliberately
# NOT committed (it's arch-specific) and is excluded via .git/info/exclude, so it
# has to be produced on demand -- this script is the single place that happens,
# shared by tmux-sidebar-toggle and tmux-agent-ls.
#
# Rebuilds when the binary is missing, older than any source file, or no longer
# runnable. The health check self-heals stale Mach-O artifacts whose invalid code
# signature makes macOS kill the sidebar before it can render. Editing a .go file
# and pressing M-Tab still picks the change up with no extra step.
#
# Output: the binary path on stdout, exit 0. On any failure (no Go toolchain,
# compile error) prints nothing and exits 1, so callers can fall back rather than
# exec'ing a path that doesn't exist.

SRC="$HOME/.config/tmux_scripts/mm-sidebar"
BIN="$SRC/mm-sidebar"

needs_build() {
    [ -x "$BIN" ] || return 0
    # -nt on each source file rather than a find|sort pipeline: this runs on every
    # M-Tab press, so it stays fork-free.
    for f in "$SRC"/*.go "$SRC"/internal/*/*.go "$SRC"/go.mod "$SRC"/go.sum; do
        [ -e "$f" ] || continue
        [ "$f" -nt "$BIN" ] && return 0
    done
    # Executable + fresh is insufficient on macOS: an invalid Mach-O signature
    # passes both checks, then the kernel kills it with SIGKILL on launch.
    "$BIN" --help >/dev/null 2>&1 || return 0
    return 1
}

if needs_build; then
    command -v go >/dev/null 2>&1 || exit 1
    # Build to a unique temp path and rename: two callers racing (M-Tab pressed
    # while tmux-agent-ls is also starting) must never leave a half-written binary
    # at $BIN. rename(2) is atomic within the directory.
    tmp="$BIN.tmp.$$"
    # -C instead of `cd $SRC &&` so no subshell/directory change is needed; -o is
    # resolved after the chdir, hence the absolute path.
    if go build -C "$SRC" -o "$tmp" . >/dev/null 2>&1 &&
        "$tmp" --help >/dev/null 2>&1; then
        mv -f "$tmp" "$BIN" 2>/dev/null || { rm -f "$tmp" 2>/dev/null; exit 1; }
    else
        rm -f "$tmp" 2>/dev/null
        exit 1
    fi
fi

printf '%s\n' "$BIN"
