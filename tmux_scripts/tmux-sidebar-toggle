#!/usr/bin/env bash
# tmux-sidebar-toggle -- M-Tab / M-S-Tab / prefix-Tab entry point for the
# mm-sidebar pane. TWO MODES, one per keybinding:
#
#   (default)  OPEN/CLOSE     no sidebar -> open it, focus it
#                             sidebar open (from anywhere) -> close it
#
#   --focus    FOCUS SWITCH   no sidebar -> open it, focus it
#              (three-state)  open, focus in content -> focus the sidebar
#                             open, focus in sidebar -> focus content, pane STAYS
#
#   --close                   close if open, never opens (for scripts)
#
# The split exists because the two gestures have different costs. Open/close pays
# a full process respawn on every re-open, which is why the reference doc once
# carried a "stash the pane via break-pane so re-open is instant" follow-up (it
# needed an AeroSpace exclusion for the holding session's window and was never
# solved). --focus is the cheap path: peek at the tree and go back without the
# pane ever dying. Both are bound, so the respawn is only paid when the intent is
# genuinely to dismiss the sidebar.
#
# Closing also works with `q`/`Esc` inside the sidebar.
#
# Window-scoped options (setw -w; per-window, so each window keeps its own sidebar
# and its own active tab -- neo-tree's per-tab isolation):
#   @sidebar_pane_id       the sidebar pane (unset when closed)
#   @sidebar_content_pane  the pane the sidebar navigates/opens into
#   @sidebar_source        active tab; deliberately NOT cleared on close, so
#                          re-opening restores the tab you were on
#
# Open runs the compiled mm-sidebar binary, falling back to the legacy bash
# dispatcher if the build fails (no Go toolchain, compile error) so M-Tab always
# does something.

set -uo pipefail

SIDEBAR_WIDTH="${TMUX_SIDEBAR_WIDTH:-36}"
SCRIPTS="$HOME/.config/tmux_scripts"
BUILD="$SCRIPTS/tmux-sidebar-build"
FALLBACK="$SCRIPTS/tmux-sidebar"

mode="${1:-toggle}"

# Double-guard: the M-Tab bind already forwards raw inside popups/nnn, but a direct
# invocation should no-op there rather than spawn a sidebar into a popup.
session=$(tmux display-message -p "${TMUX_PANE:+-t}" ${TMUX_PANE:+"$TMUX_PANE"} '#{session_name}' 2>/dev/null || true)
popup=$(tmux display-message -p '#{popup_width}' 2>/dev/null || true)
if [ -n "$popup" ] || [ "$session" = "nnn" ]; then
  exit 0
fi

# `run-shell` is asynchronous, so a fast double-press can start two copies of this
# script before either has written @sidebar_pane_id -- both would take the open path
# and the window would end up with two sidebars. mkdir is the atomic lock (macOS has
# no flock(1)); the pid + `kill -0` guard clears a lock left behind by a killed run,
# so a stale lock can never permanently break M-Tab (the failure mode the
# @in_float_popup flag hit -- see AGENTS.md).
LOCK="${TMPDIR:-/tmp}/mm-sidebar-toggle.lock"
if ! mkdir "$LOCK" 2>/dev/null; then
  if [ -f "$LOCK/pid" ] && ! kill -0 "$(cat "$LOCK/pid" 2>/dev/null)" 2>/dev/null; then
    rm -rf "$LOCK"
    mkdir "$LOCK" 2>/dev/null || exit 0
  else
    exit 0   # a press is already being handled; this one is a duplicate
  fi
fi
echo $$ >"$LOCK/pid"
trap 'rm -rf "$LOCK"' EXIT

# "Which pane am I acting for" must come from $TMUX_PANE, not `display-message -p
# '#{pane_id}'`. The latter resolves to the *currently active* pane per the attached
# client, which is not necessarily the pane this invocation belongs to -- the same
# trap AGENTS.md documents for nnn's .nnn-preview-scroll. tmux exports TMUX_PANE to
# run-shell with the target pane, so the keybinding path gets the right answer, and
# a direct invocation from inside a pane does too.
current_pane="${TMUX_PANE:-}"
[ -n "$current_pane" ] || current_pane=$(tmux display-message -p '#{pane_id}')

win_target=$(tmux display-message -p -t "$current_pane" '#{session_id}:#{window_index}')
existing=$(tmux show-options -wqv -t "$win_target" @sidebar_pane_id 2>/dev/null || true)

pane_alive() {
  [ -n "${1:-}" ] && tmux display-message -p -t "$1" '#{pane_id}' >/dev/null 2>&1
}

# return_pane resolves where focus should land when the sidebar stops holding it:
# the window's LAST ACTIVE pane, per tmux's own tracking. @sidebar_content_pane is
# the navigate/open-into target, which is a different question from "where did
# focus come from" -- bounce between two content panes and only last-pane gives
# the right answer. Falls back to it, then to any other pane in the window.
return_pane() {
  local last content other
  last=$(tmux list-panes -t "$win_target" -F '#{?pane_last,#{pane_id},}' 2>/dev/null | grep . | head -1)
  if [ -n "$last" ] && [ "$last" != "$existing" ]; then
    printf '%s' "$last"
    return 0
  fi
  content=$(tmux show-options -wqv -t "$win_target" @sidebar_content_pane 2>/dev/null || true)
  if [ "$content" != "$existing" ] && pane_alive "$content"; then
    printf '%s' "$content"
    return 0
  fi
  other=$(tmux list-panes -t "$win_target" -F '#{pane_id}' 2>/dev/null | grep -v "^$existing$" | head -1)
  printf '%s' "$other"
}

close_sidebar() {
  local target layout
  # Resolve the focus target BEFORE the kill, while the options still exist.
  target=$(return_pane)
  layout=$(tmux show-options -wqv -t "$win_target" @sidebar_saved_layout 2>/dev/null || true)

  tmux kill-pane -t "$existing" 2>/dev/null || true
  tmux set-option -wqu -t "$win_target" @sidebar_pane_id
  tmux set-option -wqu -t "$win_target" @sidebar_content_pane

  # Restore the pane sizes the window had before the sidebar squeezed them. The
  # -f (full-height) split is a whole-window geometry event, so tmux reflows every
  # pane proportionally on open and gives the reclaimed columns to an arbitrary
  # neighbor on close -- measured: a 99/40 split came back as 109/30.
  #
  # Failure is expected and must be harmless: select-layout validates the layout
  # string's checksum AND its pane count, so a pane added or killed while the
  # sidebar was open makes the saved string stale and tmux rejects it (verified).
  # That degrades to tmux's own redistribution, which is what used to happen
  # always. Clear the option either way so a stale string is never reused.
  if [ -n "$layout" ]; then
    tmux select-layout -t "$win_target" "$layout" 2>/dev/null || true
  fi
  tmux set-option -wqu -t "$win_target" @sidebar_saved_layout

  # Focus last, so it wins regardless of what select-layout did.
  pane_alive "$target" && tmux select-pane -t "$target" 2>/dev/null || true
}

if pane_alive "$existing"; then
  # Open/close (the default) and --close both dismiss an open sidebar; only
  # --focus moves focus around while keeping the pane alive.
  if [ "$mode" != "--focus" ]; then
    close_sidebar
    exit 0
  fi
  if [ "$current_pane" = "$existing" ]; then
    # Focus is in the sidebar -> hand it back to the window's last active pane,
    # keeping the sidebar alive. See return_pane for why last-pane and not
    # @sidebar_content_pane.
    target=$(return_pane)
    pane_alive "$target" && tmux select-pane -t "$target"
  else
    # Focus is in a content pane -> retarget the sidebar at THIS pane, then focus it.
    # Retargeting means the sidebar's filetree/scratch follow whichever pane you were
    # last working in, rather than staying pinned to whatever was focused at open.
    tmux set-option -wt "$win_target" @sidebar_content_pane "$current_pane"
    tmux select-pane -t "$existing"
  fi
  exit 0
fi

# No live sidebar in this window.
[ "$mode" = "--close" ] && exit 0

# Open. Prefer the compiled binary; fall back to the legacy bash dispatcher.
cmd=""
if bin=$("$BUILD" 2>/dev/null) && [ -n "$bin" ]; then
  cmd="$bin"
elif [ -x "$FALLBACK" ]; then
  cmd="$FALLBACK"
else
  exit 1
fi

content_pane="$current_pane"
cwd=$(tmux display-message -p -t "$content_pane" '#{pane_current_path}')

# Snapshot the window's pane geometry BEFORE the split, so close_sidebar can put
# it back. Only meaningful with 2+ panes -- a single-pane window has no sizes to
# preserve. Stored window-scoped so it survives this process.
panes=$(tmux display-message -p -t "$win_target" '#{window_panes}' 2>/dev/null || echo 1)
if [ "${panes:-1}" -gt 1 ]; then
  saved_layout=$(tmux display-message -p -t "$win_target" '#{window_layout}' 2>/dev/null || true)
  [ -n "$saved_layout" ] && tmux set-option -wt "$win_target" @sidebar_saved_layout "$saved_layout"
fi

# -h -f -b -l N -d: horizontal split, spanning the FULL window height (-f) rather
# than just content_pane's height, placed to the LEFT of it (-b), N columns wide.
# Without -f a content pane that isn't already full-height (the window already has
# panes stacked around it) yields a sidebar only as tall as that one pane.
#
# -d leaves the new pane UNFOCUSED: plain M-Tab must not move the active pane, it
# only opens the sidebar. The --focus mode selects it explicitly further down.
sidebar_pane=$(tmux split-window -h -f -b -d -l "$SIDEBAR_WIDTH" -t "$content_pane" -c "$cwd" \
  -P -F '#{pane_id}' "$cmd")

# Mark the pane so other scripts can detect it (tsave's filter, border coloring).
# `select-pane -T` only sets the title -- verified live that it does NOT activate
# the target pane, so it can't defeat the -d above.
tmux set-option -pt "$sidebar_pane" @sidebar_pane 1
tmux select-pane -t "$sidebar_pane" -T sidebar

tmux set-option -wt "$win_target" @sidebar_pane_id "$sidebar_pane"
tmux set-option -wt "$win_target" @sidebar_content_pane "$content_pane"
# Default tab on first open; preserved across close/re-open in the same window.
cur_source=$(tmux show-options -wqv -t "$win_target" @sidebar_source 2>/dev/null || true)
[ -n "$cur_source" ] || tmux set-option -wt "$win_target" @sidebar_source sessions

# --focus opens AND focuses; plain open leaves focus where it was (the -d above).
[ "$mode" = "--focus" ] && tmux select-pane -t "$sidebar_pane"

exit 0
