#!/usr/bin/env bash

set -euo pipefail

SEP=$'\x1f'
literal_label() {
  local value="$1"
  value=${value//$'\n'/ }
  value=${value//$'\r'/ }
  value=${value//$'\t'/ }
  value=$(printf '%s' "$value" | LC_ALL=C tr -d '\001-\010\013\014\016-\037\177')
  printf '%s' "${value//#/##}"
}

current_session_id=$(tmux display-message -p '#{session_id}')
client_width=$(tmux display-message -p '#{client_width}')
menu=()
float=()
other=()

# One global query replaces the old session -> window -> pane fork tree. Targets are
# pane IDs, while user-controlled metadata remains a display-only argv element.
while IFS="$SEP" read -r sid sname pane win_name cmd path title sidebar; do
  [ -n "$pane" ] || continue
  [ "$sid" != "$current_session_id" ] || continue
  [ "$sidebar" != 1 ] || continue
  short_path=${path/#$HOME/~}
  label=$(literal_label "$sname $win_name: $cmd [$short_path] [$title]")
  row="$label"$'\t'"$pane"
  if [[ "$sname" == float ]]; then float+=("$row"); else other+=("$row"); fi
done < <(tmux list-panes -a -F "#{session_id}${SEP}#{session_name}${SEP}#{pane_id}${SEP}#{window_name}${SEP}#{pane_current_command}${SEP}#{pane_current_path}${SEP}#{pane_title}${SEP}#{@sidebar_pane}")

append_rows() {
  local row label pane
  for row in "$@"; do
    label=${row%%$'\t'*}
    pane=${row#*$'\t'}
    menu+=("$label" "" "switch-client -t $pane")
  done
}
((${#float[@]} == 0)) || append_rows "${float[@]}"
((${#other[@]} == 0)) || append_rows "${other[@]}"
[ "${#menu[@]}" -gt 0 ] || menu+=("No other panes" "" "")
menu+=("" "" "" "" "" "" "new window" w "new-window")

tmux display-menu -M -O -T '#[align=centre]other panes' -b rounded \
  -x "$client_width" -y 1 "${menu[@]}"
