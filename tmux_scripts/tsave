#!/usr/bin/env bash

# Snapshot every active tmux session -> window -> pane to a JSON file plus a
# human-readable markdown tree, under ~/.config/tmux_sessions/. A pane running
# Claude Code is recorded with its sessionId (recovered via the pane's process
# tree -> ~/.config/claude/sessions/<pid>.json), and a pane running pi is
# recorded with its exact session id from pi's PID-keyed runtime registry.
# `tload` uses these to OFFER (not auto-run) a resume.
#   usage: tsave [name]   (name defaults to a timestamp)

set -e
set -f

name="${1:-$(date +%Y%m%d-%H%M%S)}"
case "$name" in
    ''|.|..|*[!A-Za-z0-9._-]*)
        printf 'tsave: invalid snapshot name: %s\n' "$name" >&2
        exit 2
        ;;
esac
dir="$HOME/.config/tmux_sessions"
mkdir -p "$dir"
json="$dir/$name.json"
md="$dir/$name.md"

SEP=$(printf '\037')
CODEC="$HOME/.config/tmux_scripts/tmux-snapshot-codec.py"
[ -x "$CODEC" ] || { printf 'tsave: missing snapshot codec: %s\n' "$CODEC" >&2; exit 1; }

# BFS over a pid's descendants (inclusive of itself), one pid per line.
pane_descendants() {
    queue="$1"
    while [ -n "$queue" ]; do
        set -- $queue
        pid="$1"
        shift
        queue="$*"
        printf '%s\n' "$pid"
        kids=$(pgrep -P "$pid" 2>/dev/null || true)
        [ -n "$kids" ] && queue="$queue $kids"
    done
}

# Echo the Claude sessionId for a pane (given its pane_pid), or nothing.
# Guarded on comm=claude so a stale session json for a reused pid is ignored.
claude_session() {
    for p in $(pane_descendants "$1"); do
        case "$(ps -o comm= -p "$p" 2>/dev/null)" in
            *claude*) ;;
            *) continue ;;
        esac
        f="$HOME/.config/claude/sessions/$p.json"
        if [ -f "$f" ]; then
            if sid=$(jq -er '.sessionId' "$f" 2>/dev/null); then
                printf '%s' "$sid"
                return 0
            fi
        fi
    done
    return 0
}

# Echo the exact pi session id for a pane (given its pane_pid), or nothing.
# Snapshots must never serialize cwd/newest inference as authoritative.
pi_session() {
    info=$($HOME/.config/tmux_scripts/tmux-pi-session --exact "$1" 2>/dev/null) || return 0
    printf '%s' "$(printf '%s' "$info" | awk -F '\t' '{print $4}')"
}

# @sidebar_pane is appended as a trailing field purely so the loop below can skip
# mm-sidebar panes; it is not carried into the snapshot.
fmt="#{q/a:session_name}${SEP}#{q/a:window_index}${SEP}#{q/a:window_name}${SEP}#{q/a:window_layout}${SEP}#{q/a:window_active}${SEP}#{q/a:pane_index}${SEP}#{q/a:pane_active}${SEP}#{q/a:pane_pid}${SEP}#{q/a:pane_current_path}${SEP}#{q/a:pane_current_command}${SEP}#{q/a:session_id}${SEP}#{q/a:pane_title}${SEP}#{q/a:@pane-label}${SEP}#{q/a:@pane-named}${SEP}#{q/a:@sidebar_pane}"

raw=$(mktemp "${TMPDIR:-/tmp}/tsave.raw.XXXXXX")
decoded=$(mktemp "${TMPDIR:-/tmp}/tsave.decoded.XXXXXX")
tmp=$(mktemp "${TMPDIR:-/tmp}/tsave.rows.XXXXXX")
jsonl=$(mktemp "${TMPDIR:-/tmp}/tsave.jsonl.XXXXXX")
json_tmp=$(mktemp "$dir/.${name}.json.XXXXXX")
md_tmp=$(mktemp "$dir/.${name}.md.XXXXXX")
trap 'rm -f "$raw" "$decoded" "$tmp" "$jsonl" "$json_tmp" "$md_tmp"' EXIT HUP INT TERM

# Keep list-panes outside a pipeline: its status is authoritative and must not be
# hidden by a successful downstream loop.
tmux list-panes -a -F "$fmt" >"$raw"
"$CODEC" decode 15 <"$raw" >"$decoded"
while IFS= read -r -d '' session &&
      IFS= read -r -d '' widx &&
      IFS= read -r -d '' wname &&
      IFS= read -r -d '' layout &&
      IFS= read -r -d '' wactive &&
      IFS= read -r -d '' pidx &&
      IFS= read -r -d '' pactive &&
      IFS= read -r -d '' ppid &&
      IFS= read -r -d '' cwd &&
      IFS= read -r -d '' cmd &&
      IFS= read -r -d '' sid &&
      IFS= read -r -d '' title &&
      IFS= read -r -d '' pane_label &&
      IFS= read -r -d '' pane_named &&
      IFS= read -r -d '' sidebar; do
    # Skip mm-sidebar panes. A sidebar is a UI surface owned by M-Tab, not work
    # worth restoring: tload would recreate it as a plain shell sitting in the
    # saved cwd, with the window-scoped @sidebar_* state gone, so M-Tab would then
    # open a SECOND sidebar beside the dead one. Press M-Tab after a tload instead.
    #
    # The saved window_layout still describes the window as it was, sidebar
    # included, so a restored window is one pane short of its layout -- tmux
    # tolerates that (it applies the layout to the panes that exist), and the
    # alternative (rewriting layout strings) is far more fragile.
    [ "$sidebar" = "1" ] && continue

    csid=$(claude_session "$ppid")
    psid=""
    if [ -z "$csid" ]; then
        psid=$(pi_session "$ppid")
        if [ -z "$psid" ]; then
            case "$cmd" in
                pi|node) printf 'tsave: unresolved pi pane %s (pid %s); no pi session saved\n' "$session:$widx.$pidx" "$ppid" >&2 ;;
            esac
        fi
    fi
    printf '%s\0%s\0%s\0%s\0%s\0%s\0%s\0%s\0%s\0%s\0%s\0%s\0%s\0%s\0%s\0%s\0' \
        "$session" "$widx" "$wname" "$layout" "$wactive" "$pidx" "$pactive" "$ppid" "$cwd" "$cmd" "$sid" "$title" "$pane_label" "$pane_named" "$csid" "$psid"
done <"$decoded" >"$tmp"
"$CODEC" rows 16 <"$tmp" >"$jsonl"

ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)

# Group the flat unit-separated rows into nested session/window/pane JSON.
jq -s --arg name "$name" --arg saved_at "$ts" '
    [ .[] | {
        session: .[0],
        widx: (.[1] | tonumber),
        wname: .[2],
        layout: .[3],
        wactive: (.[4] == "1"),
        pidx: (.[5] | tonumber),
        pactive: (.[6] == "1"),
        cwd: .[8],
        command: .[9],
        sidnum: (.[10] | ltrimstr("$") | tonumber),
        title: .[11],
        pane_label: .[12],
        pane_named: .[13],
        claude_session: (if (.[14] | length) > 0 then .[14] else null end),
        pi_session: (if (.[15] | length) > 0 then .[15] else null end)
      } ]
    | group_by(.session)
    | sort_by(.[0].sidnum)
    | map(
        { name: .[0].session,
          active_window: ([ .[] | select(.wactive) ][0].widx // .[0].widx),
          windows: (
            group_by(.widx) | map(
              .[0] as $w
              | { index: $w.widx,
                  name: $w.wname,
                  layout: $w.layout,
                  active_pane: ([ .[] | select(.pactive) ][0].pidx // .[0].pidx),
                  panes: (sort_by(.pidx) | map({
                      index: .pidx,
                      cwd: .cwd,
                      command: (if .claude_session != null then "claude" elif .pi_session != null then "pi" else .command end),
                      title: .title,
                      pane_label: .pane_label,
                      pane_named: .pane_named,
                      claude_session: .claude_session,
                      pi_session: .pi_session
                    }))
                }
            )
          )
        }
      )
    | { schema_version: 1, name: $name, saved_at: $saved_at, sessions: . }
' "$jsonl" >"$json_tmp"

jq -e '.schema_version == 1 and (.sessions | type == "array")' "$json_tmp" >/dev/null
mv -f "$json_tmp" "$json"

# Render the human-readable tree.
jq -r --arg home "$HOME" '
    "SESSIONS:",
    ( .sessions[] |
      " - [\(.name)]",
      ( .windows[] |
        "   - [\(.name)]",
        ( .panes[] |
          (.cwd | if startswith($home) then sub("^" + $home; "~") else . end) as $d |
          if .claude_session != null
          then "      - (\($d)) claude [\(.title | sub("^[^A-Za-z0-9]+"; ""))] \(.claude_session)"
          elif .pi_session != null
          then "      - (\($d)) pi [\(.title | sub("^[^A-Za-z0-9]+"; ""))] \(.pi_session)"
          else "      - (\($d)) \(.command) [\(.title)]"
          end
        )
      )
    )
' "$json" >"$md_tmp"
mv -f "$md_tmp" "$md"

printf '%s\n%s\n' "$json" "$md"
