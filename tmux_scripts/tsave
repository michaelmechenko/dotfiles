#!/bin/sh

# Snapshot every active tmux session -> window -> pane to a JSON file plus a
# human-readable markdown tree, under ~/.config/tmux_sessions/. A pane running
# Claude Code is recorded with its sessionId (recovered via the pane's process
# tree -> ~/.config/claude/sessions/<pid>.json), and a pane running pi is
# recorded with its session id (recovered the same way tmux-pi-last-response
# does: direct `pi` child pid -> cwd via lsof -> pi's session-dir naming -> newest
# *.jsonl's uuid). `tload` uses these to OFFER (not auto-run) a resume.
#   usage: tsave [name]   (name defaults to a timestamp)

set -e
set -f

name="${1:-$(date +%Y%m%d-%H%M%S)}"
dir="$HOME/.config/tmux_sessions"
mkdir -p "$dir"
json="$dir/$name.json"
md="$dir/$name.md"

TAB=$(printf '\t')

# BFS over a pid's descendants (inclusive of itself), one pid per line.
pane_descendants() {
    queue="$1"
    while [ -n "$queue" ]; do
        set -- $queue
        pid="$1"
        shift
        queue="$*"
        printf '%s\n' "$pid"
        kids=$(pgrep -P "$pid" 2>/dev/null || true)
        [ -n "$kids" ] && queue="$queue $kids"
    done
}

# Echo the Claude sessionId for a pane (given its pane_pid), or nothing.
# Guarded on comm=claude so a stale session json for a reused pid is ignored.
claude_session() {
    for p in $(pane_descendants "$1"); do
        case "$(ps -o comm= -p "$p" 2>/dev/null)" in
            *claude*) ;;
            *) continue ;;
        esac
        f="$HOME/.config/claude/sessions/$p.json"
        if [ -f "$f" ]; then
            if sid=$(jq -er '.sessionId' "$f" 2>/dev/null); then
                printf '%s' "$sid"
                return 0
            fi
        fi
    done
    return 0
}

# Echo the pi session id for a pane (given its pane_pid), or nothing. Mirrors
# tmux-pi-last-response: pi has no live pid-keyed session file like Claude's,
# so it's located by process tree + cwd instead. pi is a direct child of the
# pane's shell (unlike Claude, no BFS needed). Pi stores a cwd at
# `--${cwd-with-slashes-replaced-by-dashes}--`; dots remain literal.
pi_session() {
    pi_pid=$(pgrep -P "$1" -x pi 2>/dev/null | head -1)
    [ -n "$pi_pid" ] || return 0
    cwd=$(lsof -a -p "$pi_pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | tail -1)
    [ -n "$cwd" ] || return 0
    slug="--$(printf '%s' "${cwd#/}" | tr '/' '-')--"
    sess_dir="$HOME/.config/pi-config/agent/sessions/$slug"
    [ -d "$sess_dir" ] || return 0
    # Globbing is globally disabled above while walking process ids, so enable it
    # only here to select this project's newest transcript.
    transcript=$( (set +f; ls -t "$sess_dir"/*.jsonl 2>/dev/null | head -1) )
    [ -f "$transcript" ] || return 0
    printf '%s' "$(basename "$transcript" .jsonl | sed 's/^.*_//')"
}

fmt="#{session_name}${TAB}#{window_index}${TAB}#{window_name}${TAB}#{window_layout}${TAB}#{window_active}${TAB}#{pane_index}${TAB}#{pane_active}${TAB}#{pane_pid}${TAB}#{pane_current_path}${TAB}#{pane_current_command}${TAB}#{session_id}${TAB}#{pane_title}"

tmp=$(mktemp "${TMPDIR:-/tmp}/tsave.XXXXXX")
trap 'rm -f "$tmp"' EXIT

# Capture all panes, then enrich each line with the Claude sessionId and pi
# session id (last two fields).
tmux list-panes -a -F "$fmt" | while IFS="$TAB" read -r session widx wname layout wactive pidx pactive ppid cwd cmd sid title; do
    csid=$(claude_session "$ppid")
    psid=""
    [ -z "$csid" ] && psid=$(pi_session "$ppid")
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$session" "$widx" "$wname" "$layout" "$wactive" "$pidx" "$pactive" "$ppid" "$cwd" "$cmd" "$sid" "$title" "$csid" "$psid"
done >"$tmp"

ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)

# Group the flat TSV into nested session/window/pane JSON.
jq -R -s --arg name "$name" --arg saved_at "$ts" '
    [ split("\n")[] | select(length > 0) | split("\t") | {
        session: .[0],
        widx: (.[1] | tonumber),
        wname: .[2],
        layout: .[3],
        wactive: (.[4] == "1"),
        pidx: (.[5] | tonumber),
        pactive: (.[6] == "1"),
        cwd: .[8],
        command: .[9],
        sidnum: (.[10] | ltrimstr("$") | tonumber),
        title: .[11],
        claude_session: (if (.[12] | length) > 0 then .[12] else null end),
        pi_session: (if (.[13] | length) > 0 then .[13] else null end)
      } ]
    | group_by(.session)
    | sort_by(.[0].sidnum)
    | map(
        { name: .[0].session,
          active_window: ([ .[] | select(.wactive) ][0].widx // .[0].widx),
          windows: (
            group_by(.widx) | map(
              .[0] as $w
              | { index: $w.widx,
                  name: $w.wname,
                  layout: $w.layout,
                  active_pane: ([ .[] | select(.pactive) ][0].pidx // .[0].pidx),
                  panes: (sort_by(.pidx) | map({
                      index: .pidx,
                      cwd: .cwd,
                      command: (if .claude_session != null then "claude" elif .pi_session != null then "pi" else .command end),
                      title: .title,
                      claude_session: .claude_session,
                      pi_session: .pi_session
                    }))
                }
            )
          )
        }
      )
    | { name: $name, saved_at: $saved_at, sessions: . }
' "$tmp" >"$json"

# Render the human-readable tree.
jq -r --arg home "$HOME" '
    "SESSIONS:",
    ( .sessions[] |
      " - [\(.name)]",
      ( .windows[] |
        "   - [\(.name)]",
        ( .panes[] |
          (.cwd | if startswith($home) then sub("^" + $home; "~") else . end) as $d |
          if .claude_session != null
          then "      - (\($d)) claude [\(.title | sub("^[^A-Za-z0-9]+"; ""))] \(.claude_session)"
          elif .pi_session != null
          then "      - (\($d)) pi [\(.title | sub("^[^A-Za-z0-9]+"; ""))] \(.pi_session)"
          else "      - (\($d)) \(.command) [\(.title)]"
          end
        )
      )
    )
' "$json" >"$md"

printf '%s\n%s\n' "$json" "$md"
